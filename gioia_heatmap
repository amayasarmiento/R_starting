# Process each variant
process_variant <- function(variant) {
  # Extract starting part (A, T, C, G, or "del")
  start_part <- str_extract(variant, "^[ATCG]|del")
  
  # Extract loci number (first number found)
  loci <- as.numeric(str_extract(variant, "\\d+"))
  
  # Extract last letter (for substitutions)
  last_letter <- ifelse(str_detect(variant, "^del"), NA, str_extract(variant, "[ATCG]$"))
  
  # Calculate deletion length
  del_length <- ifelse(str_detect(variant, "^del"), 
                       as.numeric(str_extract(variant, "\\d+$")) - as.numeric(str_extract(variant, "(?<=del)\\d+")) + 1, 
                       NA)
  
  # Create a unified mutation category (last letter for substitutions, del_length for deletions)
  mutation_category <- ifelse(is.na(del_length), last_letter, as.character(del_length))
  
  return(data.frame(StartPart = start_part, Loci = loci, MutationCategory = mutation_category))
}

