# Compute barcode overlaps
total_barcodes <- length(unique(unlist(barcodes_list)))

overlap_summary <- data.frame(
  Comparison = c("R1 only", "R2 only", "R3 only", "R1 & R2", "R1 & R3", "R2 & R3", "All 3"),
  Count = c(
    length(setdiff(barcodes_list$R1, union(barcodes_list$R2, barcodes_list$R3))),
    length(setdiff(barcodes_list$R2, union(barcodes_list$R1, barcodes_list$R3))),
    length(setdiff(barcodes_list$R3, union(barcodes_list$R1, barcodes_list$R2))),
    length(intersect(barcodes_list$R1, barcodes_list$R2)) - length(Reduce(intersect, barcodes_list)),
    length(intersect(barcodes_list$R1, barcodes_list$R3)) - length(Reduce(intersect, barcodes_list)),
    length(intersect(barcodes_list$R2, barcodes_list$R3)) - length(Reduce(intersect, barcodes_list)),
    length(Reduce(intersect, barcodes_list))
  )
) %>%
  mutate(Percentage = round(Count / total_barcodes * 100, 2))

